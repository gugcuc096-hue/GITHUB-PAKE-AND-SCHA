# ------------------------------------------------------------------
# Pake & Scha – Umgebungsvariablen
# Lokal: als .env kopieren. Auf Render: Dashboard → Service → Environment.
# ------------------------------------------------------------------
# Auf Render: production (sichere Cookies). Lokal: development.
NODE_ENV=development
PORT=3000

# Öffentliche Adresse der Website (für Discord-Links und den Discord-Login).
# Beispiel: PUBLIC_URL=https://pake-scha.onrender.com
PUBLIC_URL=

# Speicherort der SQLite-Datenbank. Lokal leer lassen (→ data/pake-scha.db).
# Auf Render MUSS er auf einer "Persistent Disk" liegen, sonst ist die
# Datenbank nach jedem Deploy/Neustart leer. Bei Disk-Mountpfad /var/data:
# DB_PATH=/var/data/pake-scha.db
DB_PATH=

# ------------------------------------------------------------------
# Haupt-Admin: Dr. Alois Pake (Kanzleileitung)
# ------------------------------------------------------------------
# Login-E-Mail des Haupt-Admins (Standard: alois.pake@pake-scha.ls)
ADMIN_EMAIL=alois.pake@pake-scha.ls
# Start-Passwort (mind. 10 Zeichen). Leer = der Server erzeugt ein sicheres
# Zufallspasswort und schreibt es EINMALIG in die Render-Logs.
ADMIN_PASSWORD=

# Notfall-Reset ohne Shell: Passwort vergessen? Hier ein neues Passwort
# eintragen (mind. 10 Zeichen), speichern, neu deployen, einloggen –
# danach die Variable wieder LÖSCHEN.
ADMIN_RESET_PASSWORD=

# Start-Passwörter der übrigen Team-Konten (nur beim allerersten Start).
SEED_SCHA_EMAIL=michael.scha@pake-scha.ls
SEED_SCHA_PASSWORD=
SEED_LEX_EMAIL=damat.lex@pake-scha.ls
SEED_LEX_PASSWORD=

# ------------------------------------------------------------------
# Discord (optional)
# ------------------------------------------------------------------
# Webhook für Kanzlei-Updates. Kann alternativ im Dashboard unter
# "Einstellungen" hinterlegt werden (hat dann Vorrang).
DISCORD_WEBHOOK_URL=

# Discord-Login / Konto-Verknüpfung (discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Standard: PUBLIC_URL + /api/discord/callback (genau so im Discord-Portal eintragen)
DISCORD_REDIRECT_URI=

# ------------------------------------------------------------------
# FiveNet (optional)
# ------------------------------------------------------------------
# Adresse der FiveNet-Instanz, deren Dokument-Links in Akten angenommen werden.
# Kann auch im Dashboard unter "Einstellungen" gesetzt werden (hat dann Vorrang).
# Standard: https://fivenet.modernv.net
FIVENET_URL=
